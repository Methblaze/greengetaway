# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# Anchored to the root: the web build in docs/ has its own assets/node_modules/
# folder (icon fonts, back arrow) that must be committed for GitHub Pages.
/node_modules/

# Expo
.expo/
dist/
web-build/

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (Firebase keys live in .env and must never be committed)
.env
.env.*

# typescript
*.tsbuildinfo
